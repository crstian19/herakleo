{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Herakleo",
  "mainBinaryName": "herakleo-tauri",
  "version": "0.1.0",
  "identifier": "me.crstian.herakleo",
  "build": {
    "beforeDevCommand": { "script": "bun run dev:tauri", "cwd": "../../frontend" },
    "beforeBuildCommand": { "script": "bun install && bun run build:tauri", "cwd": "../../frontend" },
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Herakleo · Tauri",
        "width": 1400,
        "height": 900,
        "minWidth": 420,
        "minHeight": 500,
        "backgroundColor": "#0a0a0f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: http: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Video",
    "shortDescription": "IPTV player",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "linux": {
      "deb": { "depends": ["mpv"] },
      "rpm": { "depends": ["mpv"] }
    }
  }
}
